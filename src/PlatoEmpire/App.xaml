<Application x:Class="PlatoEmpire.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <SolidColorBrush x:Key="Plasma" Color="#FF9A1F"/>
        <SolidColorBrush x:Key="PlasmaBright" Color="#FFD080"/>
        <SolidColorBrush x:Key="PlasmaDim" Color="#7A4A10"/>
        <SolidColorBrush x:Key="PlasmaFaint" Color="#2A1A06"/>

        <!-- Toggle-style choice used for every option in the game (keeps the PLATO look; no stock light-themed controls). -->
        <Style x:Key="Choice" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource Plasma}"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="0,0,6,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" BorderBrush="{StaticResource Plasma}" BorderThickness="1"
                                Background="Black" Padding="10,4" MinWidth="30">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource PlasmaBright}"/>
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource PlasmaFaint}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Plasma}"/>
                                <Setter Property="Foreground" Value="Black"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TermButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource Plasma}"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" BorderBrush="{StaticResource Plasma}" BorderThickness="2"
                                Background="Black" Padding="28,8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Plasma}"/>
                                <Setter Property="Foreground" Value="Black"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Heading" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource PlasmaDim}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,12,0,6"/>
        </Style>

        <Style x:Key="Panel" TargetType="Border">
            <Setter Property="BorderBrush" Value="{StaticResource PlasmaDim}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Margin" Value="0,8,0,0"/>
        </Style>
    </Application.Resources>
</Application>
