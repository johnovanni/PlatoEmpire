<Window x:Class="PlatoEmpire.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:PlatoEmpire.UI"
        Title="EMPIRE  -  0empire on PLATO, recreated"
        Width="1440" Height="920" MinWidth="1100" MinHeight="720"
        Background="Black" Foreground="{StaticResource Plasma}"
        FontFamily="Consolas" FontSize="13"
        WindowStartupLocation="CenterScreen"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Grid>
        <!-- ===================== GAME SCREEN ===================== -->
        <Grid x:Name="GameRoot" Margin="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="340"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="170"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Grid.Column="0" BorderBrush="{StaticResource PlasmaDim}" BorderThickness="1">
                <ui:TacticalView x:Name="Tactical" Focusable="True" ClipToBounds="True" Cursor="None"/>
            </Border>

            <DockPanel Grid.Row="1" Grid.Column="0" Margin="0,8,0,0">
                <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource PlasmaDim}" BorderThickness="1" Margin="0,6,0,0">
                    <DockPanel>
                        <TextBlock Text="&gt;" VerticalAlignment="Center" Margin="8,0,6,0" FontSize="14"/>
                        <TextBox x:Name="CommandBox" Background="Black" Foreground="{StaticResource Plasma}"
                                 CaretBrush="{StaticResource Plasma}" BorderThickness="0" FontFamily="Consolas"
                                 FontSize="14" Padding="0,4"/>
                    </DockPanel>
                </Border>
                <Border BorderBrush="{StaticResource PlasmaDim}" BorderThickness="1">
                    <ScrollViewer x:Name="MessageScroll" VerticalScrollBarVisibility="Hidden" Focusable="False">
                        <ItemsControl x:Name="MessageList" Margin="8,4" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Text}" Foreground="{Binding Brush}" TextWrapping="Wrap"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>
            </DockPanel>

            <DockPanel Grid.Column="1" Grid.RowSpan="2" Margin="8,0,0,0" LastChildFill="True">
                <Border DockPanel.Dock="Top" BorderBrush="{StaticResource PlasmaDim}" BorderThickness="1" Height="320">
                    <ui:GalaxyMapView x:Name="GalaxyMap"/>
                </Border>

                <Border DockPanel.Dock="Top" Style="{StaticResource Panel}">
                    <StackPanel>
                        <DockPanel>
                            <TextBlock x:Name="GameClock" DockPanel.Dock="Right" Foreground="{StaticResource PlasmaDim}"/>
                            <TextBlock x:Name="ShipTitle" FontSize="15" FontWeight="Bold"/>
                        </DockPanel>
                        <TextBlock x:Name="ShipLine1" Margin="0,4,0,6"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="70"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="44"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="18"/>
                                <RowDefinition Height="18"/>
                                <RowDefinition Height="18"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="ENERGY"/>
                            <ui:BarGauge x:Name="EnergyBar" Grid.Column="1" Height="10"/>
                            <TextBlock x:Name="EnergyText" Grid.Column="2" TextAlignment="Right"/>
                            <TextBlock Grid.Row="1" Text="HULL"/>
                            <ui:BarGauge x:Name="HullBar" Grid.Row="1" Grid.Column="1" Height="10"/>
                            <TextBlock x:Name="HullText" Grid.Row="1" Grid.Column="2" TextAlignment="Right"/>
                            <TextBlock Grid.Row="2" Text="SHIELDS"/>
                            <ui:BarGauge x:Name="ShieldBar" Grid.Row="2" Grid.Column="1" Height="10"/>
                            <TextBlock x:Name="ShieldText" Grid.Row="2" Grid.Column="2" TextAlignment="Right"/>
                        </Grid>
                        <TextBlock x:Name="ShipLine2" Margin="0,6,0,0"/>
                        <TextBlock x:Name="ShipStatus" Margin="0,6,0,0" TextWrapping="Wrap" Foreground="{StaticResource PlasmaBright}"/>
                    </StackPanel>
                </Border>

                <Border DockPanel.Dock="Top" Style="{StaticResource Panel}">
                    <StackPanel>
                        <TextBlock Text="ENEMY DIFFICULTY   [ and ] to adjust" Foreground="{StaticResource PlasmaDim}" Margin="0,0,0,6"/>
                        <WrapPanel x:Name="LiveDiffPanel"/>
                        <TextBlock x:Name="LiveDiffDesc" TextWrapping="Wrap" Foreground="{StaticResource PlasmaDim}"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Panel}">
                    <ScrollViewer VerticalScrollBarVisibility="Hidden" Focusable="False">
                        <TextBlock x:Name="ScoreText" TextWrapping="NoWrap"/>
                    </ScrollViewer>
                </Border>
            </DockPanel>
        </Grid>

        <!-- ===================== SETUP ===================== -->
        <Grid x:Name="SetupOverlay" Background="#F2000000">
            <Border HorizontalAlignment="Center" VerticalAlignment="Center" BorderBrush="{StaticResource Plasma}"
                    BorderThickness="2" Padding="34,26" Background="Black" Width="780">
                <StackPanel>
                    <TextBlock Text="E  M  P  I  R  E" FontSize="52" FontWeight="Bold" HorizontalAlignment="Center"/>
                    <TextBlock Text="after the PLATO lesson 'empire' by John Daleske, 1973" HorizontalAlignment="Center"
                               Foreground="{StaticResource PlasmaDim}" Margin="0,0,0,8"/>

                    <TextBlock Style="{StaticResource Heading}" Text="CHOOSE YOUR EMPIRE"/>
                    <WrapPanel x:Name="RacePanel"/>
                    <TextBlock x:Name="RaceDesc" TextWrapping="Wrap" Foreground="{StaticResource PlasmaBright}"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Style="{StaticResource Heading}" Text="RIVAL EMPIRES"/>
                            <WrapPanel x:Name="OpponentPanel"/>
                            <TextBlock Style="{StaticResource Heading}" Text="SHIPS PER RIVAL EMPIRE"/>
                            <WrapPanel x:Name="ShipsPanel"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Style="{StaticResource Heading}" Text="ALLIED BOTS ON YOUR SIDE"/>
                            <WrapPanel x:Name="AlliesPanel"/>
                            <TextBlock Style="{StaticResource Heading}" Text="VICTORY: HOLD THIS SHARE OF THE GALAXY FOR 30s"/>
                            <WrapPanel x:Name="ConquestPanel"/>
                        </StackPanel>
                    </Grid>

                    <TextBlock Style="{StaticResource Heading}" Text="DIFFICULTY (can be changed during play)"/>
                    <WrapPanel x:Name="SetupDiffPanel"/>
                    <TextBlock x:Name="SetupDiffDesc" TextWrapping="Wrap" Foreground="{StaticResource PlasmaBright}"/>

                    <Button Content="ENGAGE" Style="{StaticResource TermButton}" Click="Start_Click"
                            HorizontalAlignment="Center" Margin="0,24,0,8"/>
                    <TextBlock Text="ENTER to start  ·  H in game for controls" HorizontalAlignment="Center"
                               Foreground="{StaticResource PlasmaDim}"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ===================== HELP ===================== -->
        <Grid x:Name="HelpOverlay" Background="#E6000000" Visibility="Collapsed" MouseLeftButtonDown="Help_Click">
            <Border HorizontalAlignment="Center" VerticalAlignment="Center" BorderBrush="{StaticResource Plasma}"
                    BorderThickness="2" Padding="30,22" Background="Black">
                <TextBlock x:Name="HelpText" FontSize="14" LineHeight="20"/>
            </Border>
        </Grid>

        <!-- ===================== GAME OVER ===================== -->
        <Grid x:Name="GameOverOverlay" Background="#D0000000" Visibility="Collapsed">
            <Border HorizontalAlignment="Center" VerticalAlignment="Center" BorderBrush="{StaticResource Plasma}"
                    BorderThickness="2" Padding="40,26" Background="Black" MinWidth="520">
                <StackPanel>
                    <TextBlock x:Name="GameOverTitle" FontSize="44" FontWeight="Bold" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="GameOverText" FontSize="15" Margin="0,14,0,0" HorizontalAlignment="Center" TextAlignment="Center"/>
                    <Button Content="NEW GAME" Style="{StaticResource TermButton}" Click="NewGame_Click"
                            HorizontalAlignment="Center" Margin="0,22,0,0"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
